# Supabase (legacy - kept live until Firebase parity is proven, then removed)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
VITE_NATIVE_AUTH_REDIRECT_URL=com.navafit.alignment://auth-callback

# Firebase Web SDK config (safe to commit into env - not secrets).
# Values come from Firebase Console > Project settings > Your apps > Web app > SDK setup and configuration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=navafit-alignment-9b93e
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional (only if Analytics enabled during Web app registration):
VITE_FIREBASE_MEASUREMENT_ID=

# Feature flag: 'supabase' (current live) or 'firebase' (post-migration).
# Leave as 'supabase' until user data has been imported and smoke tested.
VITE_AUTH_BACKEND=supabase
