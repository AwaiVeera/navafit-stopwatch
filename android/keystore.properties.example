# Android release signing — copy to android/keystore.properties and fill in.
# The real keystore.properties is git-ignored (see .gitignore). Never commit it,
# and never commit the .keystore/.jks file it points to.
#
# Generate the upload keystore once (keep it backed up forever — losing it blocks
# all future Play updates):
#   keytool -genkey -v -keystore navafit-upload.keystore \
#     -alias navafit-upload -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile may be absolute, or relative to the android/ directory
# (rootProject), e.g. navafit-upload.keystore if kept alongside this file.

storeFile=navafit-upload.keystore
storePassword=CHANGE_ME
keyAlias=navafit-upload
keyPassword=CHANGE_ME
